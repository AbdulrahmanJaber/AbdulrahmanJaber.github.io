---
import BaseLayout from "../layouts/BaseLayout.astro";
import { education, experience } from "../data/experience";
import { site } from "../data/site";
---

<BaseLayout title="About" description={`About ${site.name}, machine learning engineer and researcher.`}>
  <section class="page-intro shell">
    <p class="eyebrow">About</p>
    <h1>I work where model performance meets real-world constraints.</h1>
    <div class="intro-columns">
      <p class="lede">My background moves between electrical engineering, communications, and machine learning research.</p>
      <div class="prose">
        <p>I completed my bachelor’s degree at Beirut Arab University and my master’s degree at the American University of Beirut.</p>
        <p>My recent research focuses on differential privacy, fairness-aware training, and adaptive optimization. Earlier work includes UAV security, computer vision for dense crowds, and football outcome forecasting.</p>
        <p>I care about experiments that are reproducible, claims that match the evidence, and systems that acknowledge their limits.</p>
      </div>
    </div>
  </section>
  <section class="section shell">
    <div class="section-heading"><p class="eyebrow">Path</p><p class="section-note">Research, teaching, and engineering practice.</p></div>
    <div class="timeline">
      {experience.map((item) => <article class="timeline-row"><p class="timeline-period mono">{item.period}</p><div><h3>{item.role}</h3><p>{item.organization}</p></div><p>{item.detail}</p></article>)}
      {education.map((item) => <article class="timeline-row"><p class="timeline-period mono">{item.year}</p><div><h3>{item.degree}</h3><p>{item.school}</p></div><p>Academic foundation in electrical, computer, and communication engineering.</p></article>)}
    </div>
  </section>
</BaseLayout>
