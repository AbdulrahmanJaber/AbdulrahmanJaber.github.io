---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { education, experience } from "../data/experience";
import { skillGroups } from "../data/skills";
import { site } from "../data/site";

const projects = (await getCollection("projects"))
  .filter(({ data }) => data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-label mono">ML ENGINEER / RESEARCHER</div>
    <div class="hero-copy">
      <h1>Engineering machine learning that respects constraints.</h1>
      <p>
        I’m Abdulrahman Jaber, an electrical and computer engineer working across
        privacy, fairness, optimization, computer vision, and reliable AI systems.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">Selected work ↓</a>
        <a class="button button-quiet" href={`mailto:${site.email}`}>Start a conversation ↗</a>
      </div>
    </div>
    <dl class="hero-facts">
      <div><dt>Based in</dt><dd>{site.location}</dd></div>
      <div><dt>Focus</dt><dd>Private & fair ML</dd></div>
      <div><dt>Published</dt><dd>Information, 2025</dd></div>
    </dl>
  </section>

  <section class="section shell" id="work">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <p class="section-note">Four projects spanning research, security, vision, and predictive modeling.</p>
    </div>
    <div class="project-list">
      {projects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}
    </div>
  </section>

  <section class="statement-section">
    <div class="shell statement-grid">
      <p class="eyebrow">Current research</p>
      <blockquote>
        How can a model protect individual data without quietly making its worst-served group worse?
      </blockquote>
      <p class="statement-copy">
        My master’s work studies adaptive optimization under differential privacy, with fairness signals designed around minority-group learning dynamics.
      </p>
    </div>
  </section>

  <section class="section shell" id="experience">
    <div class="section-heading">
      <p class="eyebrow">Experience</p>
      <p class="section-note">Research backed by an electrical and communications engineering foundation.</p>
    </div>
    <div class="timeline">
      {experience.map((item) => (
        <article class="timeline-row">
          <p class="timeline-period mono">{item.period}</p>
          <div><h3>{item.role}</h3><p>{item.organization}</p></div>
          <p>{item.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell compact-section">
    <div class="two-column">
      <div>
        <p class="eyebrow">Education</p>
        <div class="education-list">
          {education.map((item) => (
            <article><span class="mono">{item.year}</span><h3>{item.degree}</h3><p>{item.school}</p></article>
          ))}
        </div>
      </div>
      <div>
        <p class="eyebrow">Capabilities</p>
        <div class="skills-list">
          {skillGroups.map((group) => (
            <div><h3>{group.label}</h3><p>{group.items.join(" · ")}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
